{
  "name": "campus-coin",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Coin API contract and application workspace",
  "type": "module",
  "scripts": {
    "api:validate": "redocly lint docs/contracts/openapi.yaml",
    "api:bundle": "redocly bundle docs/contracts/openapi.yaml -o artifacts/openapi.json",
    "api:types": "openapi-typescript docs/contracts/openapi.yaml -o artifacts/api.d.ts",
    "verify:docs": "npm run api:validate && git diff --check",
    "db:status": "cross-env node --env-file=.env src/infrastructure/db/migrate.ts status",
    "db:preflight": "cross-env node --env-file=.env src/infrastructure/db/migrate.ts preflight",
    "db:reconcile": "cross-env node --env-file=.env src/infrastructure/db/reconcile.ts",
    "db:operation-log": "cross-env node --env-file=.env src/infrastructure/db/record-operation.ts",
    "db:datatest": "cross-env node --env-file=.env datatest/run.ts",
    "db:datatest:ci": "cross-env CAMPUS_COIN_TEST_DB=1 node datatest/run.ts",
    "db:migrate": "cross-env node --env-file=.env src/infrastructure/db/migrate.ts up",
    "benchmark": "cross-env node --env-file=.env benchmark/run.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:mysql:required": "cross-env CAMPUS_COIN_TEST_DB=1 node --import tsx --test \"test/**/*.test.ts\"",
    "test:web": "vitest run src/web",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/app/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc",
    "build:web": "vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/app/server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.0",
    "express": "^4.21.0",
    "google-auth-library": "^9.0.0",
    "lucide-react": "^0.444.0",
    "mysql2": "^3.24.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.54.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  }
}
