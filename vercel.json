{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run build && npm run api:validate",
  "outputDirectory": "dist",
  "functions": {
    "api/v1/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "db/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
