# Campus Coin local development template.
# Copy to .env and fill values locally. Never commit .env or paste its contents into tools/chat.
# Do not use production secrets or production databases in local, preview, or test environments.
# Load values through dotenv (dotenv.config) or the runtime's approved env-file loader.

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false
TRUSTED_PROXY_IPS=

# Replace locally with independently generated random values of at least 32 bytes.
# Empty placeholders are intentional; startup validation must fail closed until configured.
OTP_SECRET=
SESSION_SECRET=
AUTH_RATE_LIMIT_SECRET=
CAMPUS_COIN_CURSOR_SIGNING_KEY=

# SMTP is optional for local tests; use a sandbox/test SMTP account only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_TIMEOUT_MS=5000
EMAIL_FROM=

# MySQL: use an isolated disposable local/test database, never production.
CAMPUS_COIN_DB_HOST=127.0.0.1
CAMPUS_COIN_DB_PORT=3306
CAMPUS_COIN_DB_NAME=campus_coin_local
CAMPUS_COIN_DB_USER=
CAMPUS_COIN_DB_PASSWORD=
CAMPUS_COIN_DB_SSL=disabled
CAMPUS_COIN_DB_CA_PATH=
CAMPUS_COIN_DB_CONNECTION_LIMIT=5
CAMPUS_COIN_DB_MIGRATE_USER=
CAMPUS_COIN_DB_MIGRATE_PASSWORD=
CAMPUS_COIN_DB_OPS_USER=
CAMPUS_COIN_DB_OPS_PASSWORD=
CAMPUS_COIN_TEST_DB=1
CAMPUS_COIN_MIGRATIONS_DIR=

# Local deterministic category index keeps the same JEV response/status contract without a provider key.
JEV_LOCAL_CATEGORY_SUGGESTION_ENABLED=true
JEV_CATEGORY_SUGGESTION_ENABLED=false
JEV_MINIMUM_CONFIDENCE=
JEV_MAX_CANDIDATES=
NGHIENAI_LLM_ENABLED=false
NGHIENAI_API_KEY=
NGHIENAI_BASE_URL=
NGHIENAI_MINIMUM_CONFIDENCE=
NGHIENAI_MAX_CANDIDATES=

# C auth settings; keep credentials blank and use a local OAuth client only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SESSION_MAX_AGE_HOURS=24
# Thêm `; Secure` vào cookie phiên kể cả khi NODE_ENV khác production (test/integration).
SESSION_SECURE=false
SESSION_SAME_SITE=lax
ALLOWED_ORIGINS=http://127.0.0.1:5173
LOG_LEVEL=info
