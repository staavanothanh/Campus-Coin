# Google OAuth
# Cấu hình Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://campus-coin.vercel.app/api/v1/auth/google/callback

# Database
# Cấu hình kết nối Cơ sở dữ liệu MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=campus_coin
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Session
# Cấu hình phiên đăng nhập (Session)
SESSION_MAX_AGE_HOURS=24
SESSION_SECURE=true
SESSION_SAME_SITE=lax

# App
# Cấu hình Ứng dụng chung
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://campus-coin.vercel.app
LOG_LEVEL=info

# JEV
# Tính năng gợi ý danh mục JEV
JEV_CATEGORY_SUGGESTION_ENABLED=false
